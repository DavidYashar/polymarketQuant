# Network
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
GAMMA_HOST=https://gamma-api.polymarket.com

# League tag IDs (defaults are correct as of Feb 2026)
TAG_NFL=450
TAG_NBA=745
TAG_EPL=82
TAG_LA_LIGA=780
TAG_BUNDESLIGA=1494
TAG_SERIE_A=101962

# Filter which sports market types to ingest (comma-separated)
SPORTS_MARKET_TYPES=moneyline

# Pagination / performance
PAGE_LIMIT=100
ENRICH_CLOB=true
CLOB_MAX_CONCURRENT=6

# Output
DATA_DIR=data
LOG_DIR=logs

# Where snapshots are written (so data/ can stay clean)
SNAPSHOT_DIR=logs/snapshots

# Watch mode refresh
REFRESH_SECONDS=300

# Paper betting / ledger
# Only consider games whose market endDate is within the next N hours
MAX_HOURS_AHEAD=24

# Where paper bets are recorded
LEDGER_PATH=data/ledger.json

# Current bot state (open bets + cash)
STATE_PATH=data/state.json

# Bet sizing
# Each placed bet uses this fraction of current ledger balance.
# Example: 0.05 = 5% per bet. A 3-outcome soccer game places 2 bets (10% total).
BET_PCT_PER_BET=0.05

# Optional minimum bet size in USD (useful when balance gets small)
MIN_BET_USD=1

# Cap total amount staked per selection run as a fraction of current cash.
# Example: 0.60 means we will never stake more than 60% of available cash,
# leaving at least 40% unallocated.
MAX_ALLOC_PCT=0.60

# Selection guardrails
# Skip outcomes with YES price above this (high price = low upside, but usually lower risk).
# Set lower (e.g. 0.85) if you want more payout potential.
MAX_YES_PRICE=0.99

# Cap how many games we bet per run (prevents allocating too much at once)
MAX_GAMES_PER_RUN=20

# Scoring mode for selecting outcomes within a game
# - implied: use Gamma outcomePrices (probability proxy)
# - depth: use per-outcome orderbook depth share (requires ENRICH_CLOB=true)
# - hybrid: weighted mix of implied + depth share
PICK_SCORE_MODE=hybrid

# Only used when PICK_SCORE_MODE=hybrid (0..1). Higher = more weight on depth share.
PICK_DEPTH_WEIGHT=0.35
