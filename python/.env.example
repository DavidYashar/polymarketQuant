# Postgres connection to the HL warehouse (running on the same Ubuntu laptop).
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=hl_warehouse
PG_USER=postgres
PG_PASSWORD=postgres

# Polymarket public APIs (no auth needed for read-only).
POLY_GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CLOB_HOST=https://clob.polymarket.com

# Calibration window (UTC). Defaults to the last 30 days if unset.
# CALIB_START_ISO=2026-03-01T00:00:00
# CALIB_END_ISO=2026-04-01T00:00:00

# Coins to study. Comma separated. HL warehouse symbols.
CALIB_COINS=BTC,ETH,SOL,XRP

# Where to write the report.
CALIB_REPORT_PATH=docs/calibration_hourly_crypto.md
